{
  "info": {
    "name": "FocusTask - Render com JWT",
    "description": "Preparado a partir do ZIP auditado. Importável no Insomnia; formato Postman Collection 2.1. Não executado contra a API. Rode manualmente na ordem. Copie os IDs retornados para o ambiente. Sem autenticação porque o ZIP ainda não implementa Security.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Cadastro e autenticação",
      "item": [
        {
          "name": "Saúde pública [200]",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/actuator/health",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Cadastrar conta [201]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Insomnia\",\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login e copiar token [200]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Minha conta [200]",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/me"
          }
        }
      ]
    },
    {
      "name": "02 - Criar projeto, tarefa e sessão e copiar IDs",
      "item": [
        {
          "name": "02 Criar projeto [201]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/projects",
            "description": "Resultado esperado: HTTP 201. Copie id para project_id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Projeto Insomnia\",\n  \"description\": \"Dados criados para testar a API\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "03 Criar tarefa no projeto [201]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/projects/{{project_id}}/tasks",
            "description": "Resultado esperado: HTTP 201. Copie id para task_id. Confira projectId, status TODO, priority MEDIUM e header Location.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Estudar Spring\",\n  \"description\": \"Primeiro teste de Task\",\n  \"dueDate\": \"2026-10-05\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "04 Criar sessão avulsa [201]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json, application/problem+json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/focus-sessions",
            "description": "Resultado esperado: HTTP 201. Copie id para session_id. taskId deve ser null; status RUNNING.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
