# Backend dev (MySQL). Copy to .env at the project root and replace credentials.
# Run Maven from the project root so application-dev.properties imports .env.
FOCUSTASK_DB_URL=jdbc:mysql://localhost:3306/focustask
FOCUSTASK_DB_USERNAME=replace-with-your-mysql-user
FOCUSTASK_DB_PASSWORD=replace-with-your-mysql-password
FOCUSTASK_CORS_ALLOWED_ORIGINS=http://localhost:5173
FOCUSTASK_SHOW_SQL=false

# Local Docker Compose (PostgreSQL, prod profile).
POSTGRES_DB=focustask
POSTGRES_USER=focustask
POSTGRES_PASSWORD=replace-with-a-local-test-password
APP_PORT=8080

# Generate locally: openssl rand -hex 32
FOCUSTASK_JWT_SECRET=

# Hosted backend (prod): configure these in the hosting environment.
# DB_URL=jdbc:postgresql://host:5432/focustask?sslmode=require
# DB_USERNAME=replace-with-your-postgres-user
# DB_PASSWORD=replace-with-your-postgres-password
# FOCUSTASK_CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
